# ── LLM 백엔드 (Groq GPT OSS / 로컬 Ollama / OpenAI 호환) ────────────────
# 백엔드 프로바이더 선택: groq | ollama | openai (미설정 시 키/URL로 자동 감지)
LLM_PROVIDER=groq

# 1) Groq LPU (GPT OSS - Llama 3.3 70B, Qwen 2.5, DeepSeek R1 등 초고속 오픈소스 LLM API)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
# 모델 목록은 앱이 Groq API에서 실시간으로 받아온다(Groq는 모델을 수시로 폐기한다).
# 2026-08 기준 채팅 가능 모델: llama-3.3-70b-versatile, llama-3.1-8b-instant,
#   openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b, groq/compound

# 2) OpenAI GPT
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o

# 3) 로컬 Ollama (온디바이스/오프라인)
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b-instruct

# ── (선택) 스톡 이미지 검색 (저작권 안전, 생성 아님) ────────────────────
UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# ── (선택) 문서 파싱 API ─────────────────────────────────────────────────
POLARIS_API_KEY=
POLARIS_API_ENDPOINT=https://datainsight.polarisoffice.com/_api/v1/parse
