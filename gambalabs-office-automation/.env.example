# 감바랩스 오피스 AI — 환경 설정 예시
#
# ▶ 이 파일을 복사해서 이름을 ".env" 로 바꾼 뒤 값을 채우세요.
#   (앱의 좌측 "🔑 API 키 설정"에서 입력하면 이 파일이 자동으로 만들어집니다 — 그게 더 쉽습니다)
# ▶ .env 는 절대 공유·커밋하지 마세요. 키가 그대로 노출됩니다.

# ── LLM 백엔드 ────────────────────────────────────────────────
# groq | openai | ollama   (비워 두면 키 유무로 자동 감지)
LLM_PROVIDER=groq

# 1) Groq — 빠르고 무료 티어가 있다. PPT 자유 설계에 권장.
#    키 발급: https://console.groq.com/keys
GROQ_API_KEY=
# 보조 키(선택). 첫 키가 한도(TPM)에 걸리면 자동으로 이 키로 넘어간다.
GROQ_API_KEY2=
GROQ_MODEL=llama-3.3-70b-versatile
# 모델 목록은 앱이 Groq API에서 실시간으로 받아온다(Groq는 모델을 수시로 폐기한다).

# 2) OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# 3) 로컬 Ollama (오프라인·키 불필요). 쓰려면 아래 두 줄의 주석을 풀고 LLM_PROVIDER=ollama.
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=qwen2.5:7b-instruct

# ── PPT 엔진 동작 (선택) ──────────────────────────────────────
# 자유 설계(모델이 레이아웃 코드를 직접 작성)를 끄려면 0
# PPT_FREE_LAYOUT=1
# 코드 생성 전용 모델 강제 (기본: Groq면 openai/gpt-oss-120b 우선 자동 선택)
# PPT_CODE_MODEL=
# 설계 모드 강제: auto | template | freeform
# PPT_DESIGN_MODE=auto

# ── 스톡 이미지 (선택) ────────────────────────────────────────
# 비워 두면 키가 필요 없는 Openverse(CC)로 자동 폴백한다.
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=

# ── 작업 폴더 바꾸기 (선택) ───────────────────────────────────
# 결과물·테마·.env 를 다른 폴더에 두고 싶을 때만. 기본은 exe(또는 프로젝트) 폴더.
# GAMBA_DATA_DIR=D:\GambaOffice
