# ── LLM 백엔드 (OpenAI 호환) ─────────────────────────────
# 데모: OpenAI GPT 사용 (제안서/샘플=외부향 데이터라 허용 범위)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
# 엔드포인트 스왑: 미설정=OpenAI. 사내/로컬로 바꾸려면 base_url 지정
#   로컬 Ollama:  OPENAI_BASE_URL=http://localhost:11434/v1  (OPENAI_MODEL=qwen2.5:7b-instruct)
#   사내 LLM 서버: OPENAI_BASE_URL=http://<사내서버>:11434/v1
#   Azure OpenAI : 별도 azure 설정 사용
# OPENAI_BASE_URL=

# ── (선택) 스톡 이미지 검색 (저작권 안전, 생성 아님) ────
# 슬라이드 [이미지: 설명] 지시를 실제 이미지로 채움. 없으면 플레이스홀더.
UNSPLASH_ACCESS_KEY=
# PEXELS_API_KEY=

# ── (선택) 문서 파싱 API ─────────────────────────────────
# 비정형 HWP/PDF 구조화가 필요할 때. 없으면 로컬 파서로 폴백.
POLARIS_API_KEY=
POLARIS_API_ENDPOINT=https://datainsight.polarisoffice.com/_api/v1/parse
